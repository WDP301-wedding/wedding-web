# Public browser configuration. Never place credentials or service-role keys here.
#
# Cách 1 (khuyên dùng): đi qua proxy của Next.js để giữ cookie phiên cùng site.
#   - BACKEND_ORIGIN: địa chỉ backend thật (biến server, không lộ ra trình duyệt).
#   - NEXT_PUBLIC_API_BASE_URL: trỏ về chính web đang chạy.
BACKEND_ORIGIN=https://wedding-be-render-trial.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
#
# Cách 2: chạy backend local (cùng site localhost nên không cần proxy).
# BACKEND_ORIGIN=
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
