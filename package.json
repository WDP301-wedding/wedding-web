    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
