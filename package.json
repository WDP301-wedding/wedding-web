{
  "name": "wedding-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public, guest, and couple web application for the wedding management system.",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "audit:ci": "node scripts/audit-ci.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "print:generate": "node scripts/build-invitation-print.mjs",
    "print:check": "node scripts/build-invitation-print.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:audit-policy": "node --test scripts/audit-ci.test.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.1",
    "sonner": "2.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.5"
  }
}
